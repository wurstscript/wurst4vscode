{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "npm",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"compile",
				"--loglevel",
				"silent"
			],
			"isBackground": true,
			"problemMatcher": "$tsc-watch",
			"group": {
				"kind": "build",
				"isDefault": false
			}
		},
		{
			"type": "npm",
			"script": "compile-web",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$ts-webpack"
			]
		},
		{
			"type": "npm",
			"script": "watch-web",
			"group": "build",
			"isBackground": true,
			"problemMatcher": {
				"owner": "webpack",
				"pattern": {
					"regexp": "^ERROR in (.+)$",
					"file": 1
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "webpack\\.config\\.js",
					"endsPattern": "compiled (successfully|with \\d+ warning)"
				}
			}
		}
	]
}