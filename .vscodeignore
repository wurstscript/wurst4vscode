.vscode/**
.github/**
.claude/**
# CI-only stand-ins for the private sibling packages. Shipping them leaks the
# type surface of casc-ts and war3-model, and nothing loads them at runtime.
.ci/**
src/**
out/**
node_modules/**
scripts/**
e2e/**
wc3data/**
logs/**
# Playwright leaves these behind locally, and release packaging happens right
# after a local e2e run. Traces carry full DOM and network snapshots.
test-results/**
playwright-report/**
resources/wc3-knowledge-base.json
test/**
tests/**
__tests__/**
fixtures/**
docs/**
images/marketplace/**
*.test.*
*.spec.*
*.vsix
tsconfig*.json
webpack.config.js
playwright.config.js
.gitignore
.eslintrc*
eslint.config.js
.editorconfig
.prettierrc
AGENTS.md
CLAUDE.md
vsc-extension-quickstart.md
package-lock.json
# dist/ is in .gitignore, so explicitly re-include only runtime artifacts
!dist/**/*.js
!dist/**/*.txt
# source maps are only useful for local debugging, don't ship them
dist/**/*.map
**/*.map
